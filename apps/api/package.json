{
  "name": "@dafter/api",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "bundle": "esbuild dist/vercel.js --bundle --platform=node --target=node22 --format=cjs --outfile=dist/vercel.bundle.cjs --external:@node-rs/argon2 --external:pg-native --external:@nestjs/microservices --external:@nestjs/websockets --external:@nestjs/platform-express --external:class-validator --external:class-transformer --external:@fastify/static --external:@fastify/view --external:@fastify/multipart --log-level=warning",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@dafter/contracts": "workspace:*",
    "@dafter/db": "workspace:*",
    "@fastify/cookie": "^11.1.5",
    "@nestjs/common": "^12.4.2",
    "@nestjs/core": "^12.4.2",
    "@nestjs/jwt": "^12.0.4",
    "@nestjs/platform-fastify": "^12.4.2",
    "@node-rs/argon2": "^2.2.2",
    "drizzle-orm": "^0.45.4",
    "pg-boss": "12.38.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@dafter/config": "workspace:*",
    "@nestjs/cli": "^12.0.12",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/node": "^22.20.5",
    "esbuild": "0.28.2",
    "fastify": "^5.12.8",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
