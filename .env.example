# Copy to .env for local development. Never commit .env.

# API
PORT=3000
DATABASE_URL=postgres://dafter:dafter@localhost:5432/dafter
# Run the pg-boss worker inside the API process (local dev and the free-tier deploy).
RUN_WORKER=true
# Signs access JWTs (HS256). Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Web (Vite only exposes VITE_* variables to the browser).
# Empty = same origin: in dev, Vite proxies /api and /health to the API.
VITE_API_URL=

# Development only: exposes GET /api/v1/dev/mail?to= so Playwright can read login codes.
# Never set in production.
DEV_MAIL_INBOX=1
# Derives each session's QR key (HMAC). Generate like JWT_SECRET; different value.
QR_SECRET=change-me-to-another-long-random-string
