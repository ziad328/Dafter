# Copy to .env for local development. Never commit .env.

# API
PORT=3000
DATABASE_URL=postgres://dafter:dafter@localhost:5432/dafter
# Neon only: the direct (non-pooled) URL for migrations and pg-boss. Empty = DATABASE_URL.
DATABASE_URL_UNPOOLED=
# Run the pg-boss worker inside the API process (local dev and the free-tier deploy).
RUN_WORKER=true
# Serverless hosts (Vercel): GET /api/v1/internal/tick needs `Authorization: Bearer <CRON_SECRET>`. Empty = off.
CRON_SECRET=
# Long-running hosts (a VPS): apply migrations when the API starts. Vercel deploys migrate from a laptop
# (pnpm demo:seed:neon); local dev uses pnpm db:migrate / db:reset.
MIGRATE_ON_START=0
# Behind the host's proxy (Vercel): read the client IP from X-Forwarded-For. Never locally.
TRUST_PROXY=0
# Student login codes: console (default) or brevo (needs BREVO_API_KEY and MAIL_FROM, a verified sender).
MAIL_PROVIDER=console
BREVO_API_KEY=
MAIL_FROM=
# Signs access JWTs (HS256). Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Web (Vite only exposes VITE_* variables to the browser).
# Empty = same origin: in dev, Vite proxies /api and /health to the API.
VITE_API_URL=

# Development only: exposes GET /api/v1/dev/mail?to= so Playwright can read login codes.
# Never set in production.
DEV_MAIL_INBOX=1
# Development and demos: GET /api/v1/dev/phone and the /dev/phone page show sent parent messages.
DEV_FAKE_PHONE=1
# Derives each session's QR key (HMAC). Generate like JWT_SECRET; different value.
QR_SECRET=change-me-to-another-long-random-string
