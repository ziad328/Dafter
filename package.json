{
  "name": "dafter",
  "private": true,
  "packageManager": "pnpm@11.5.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "docker compose -f infra/docker-compose.yml up -d --wait && turbo run dev",
    "build": "turbo run build",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm lint && pnpm format:check && turbo run typecheck test",
    "contracts:gen": "pnpm --filter @dafter/contracts gen && pnpm --filter @dafter/web codegen && prettier --write packages/contracts/openapi.json apps/web/src/api/generated.ts",
    "e2e": "pnpm --filter @dafter/e2e e2e",
    "e2e:live": "pnpm --filter @dafter/e2e e2e:live",
    "i18n:check": "pnpm --filter @dafter/i18n test",
    "db:up": "docker compose -f infra/docker-compose.yml up -d --wait",
    "db:generate": "pnpm --filter @dafter/db generate",
    "db:migrate": "pnpm --filter @dafter/db migrate",
    "db:seed": "pnpm --filter @dafter/db seed",
    "db:seed:demo": "pnpm --filter @dafter/db seed:demo",
    "demo:seed:neon": "pnpm --filter @dafter/db seed:demo:neon",
    "db:reset": "pnpm db:up && pnpm --filter @dafter/db reset",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "lefthook": "^2.2.2",
    "playwright-core": "^1.65.0",
    "prettier": "^3.10.0",
    "turbo": "^2.11.11",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}
